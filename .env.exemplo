# Provedor de IA para tradução de lotes e tarefas ('deepseek' ou 'gemini')
PROVEDOR_IA=deepseek

# Modelo opcional (se omitido, usa deepseek-chat ou gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite
# DEEPSEEK_MODEL=deepseek-flash

# Chave da API do DeepSeek
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui

# Chave da API do Gemini (Google AI Studio)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Chave da API do Google Tradutor
GOOGLE_TRANSLATE_API_KEY=sua_chave_google_aqui
